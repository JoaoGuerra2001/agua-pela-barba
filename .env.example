# Copie para .env (ou defina estas variáveis no serviço onde publicar)
PORT=3000
BASE_URL=https://o-seu-dominio.pt
# Palavra-passe do painel /admin (utilizador: qualquer um)
ADMIN_PASSWORD=escolha-uma-palavra-passe-forte
# Ligação à base de dados Postgres (Supabase: Project Settings > Database > Connection string, modo "Session pooler").
# É um segredo: defina-o só nas variáveis do alojamento, nunca no GitHub.
DATABASE_URL=postgresql://utilizador:palavra-passe@servidor:5432/postgres

# Cópia diária e "manter ativo" (Vercel Cron). CRON_SECRET: texto longo inventado por si.
# BLOB_READ_WRITE_TOKEN: aparece sozinho ao ligar um Vercel Blob (privado) ao projeto.
CRON_SECRET=
BLOB_READ_WRITE_TOKEN=

# Pagamento online (opcional até ter conta Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Aviso a cada nova marcação (opcional): URL de um serviço tipo ntfy.sh/o-seu-canal
NOTIFY_WEBHOOK=
